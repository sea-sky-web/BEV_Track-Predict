# Required
COLAB_NOTEBOOK_URL=https://colab.research.google.com/drive/REPLACE_WITH_NOTEBOOK_ID
REPO_PATH=C:/Users/zhangweichao/Desktop/BEV_Track&Predict
RESULT_DIR=C:/Users/zhangweichao/Google Drive/My Drive/colab_runs/bev_track_predict
PLAYWRIGHT_PROFILE_DIR=./runtime/playwright_profile

# Git
GIT_BRANCH=main
GIT_REMOTE_NAME=origin

# Result file names (should match notebook outputs)
STATUS_FILE_NAME=status.json
METRICS_FILE_NAME=metrics.json
ERROR_FILE_NAME=last_error.txt
TRAIN_LOG_FILE_NAME=train.log

# Loop controls
POLL_INTERVAL_SECONDS=20
ROUND_TIMEOUT_SECONDS=10800
MAX_ROUNDS=5
LAUNCH_RETRY=3
LOOP_SLEEP_SECONDS=10

# Playwright
SELECTOR_TIMEOUT_MS=15000
PLAYWRIGHT_HEADLESS=false
# Optional: chrome / msedge / chromium
PLAYWRIGHT_CHANNEL=
# Set true to attach to an already-running Chrome (requires --remote-debugging-port)
PLAYWRIGHT_ATTACH_EXISTING_CHROME=false
# CDP endpoint when attaching mode is enabled
PLAYWRIGHT_CDP_URL=http://127.0.0.1:9222
# In attach mode, open a new tab instead of reusing the first existing tab
PLAYWRIGHT_ATTACH_NEW_TAB=true

# AI patch module
MODEL_CONFIG_PATH=./configs/config.py
AUTO_APPLY_PATCH=false
PATCH_OUTPUT_DIR=./runtime/patches

# Logging
LOG_DIR=./runtime/logs
